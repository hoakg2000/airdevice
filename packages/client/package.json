{
  "name": "@air-device/client",
  "version": "0.1.0",
  "description": "Headless AirDevice SDK: WebRTC peer with perfect negotiation, host (desktop) and camera (phone) sessions.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoakg2000/airdevice.git",
    "directory": "packages/client"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@air-device/protocol": "workspace:^",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.0.2",
    "vitest": "^2.1.9"
  }
}

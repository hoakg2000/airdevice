{
  "name": "air-device-monorepo",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "dev:infra": "docker compose -f docker/docker compose.yml up -d redis",
    "dev": "pnpm -r --parallel --filter \"./apps/*\" --filter @air-device/element run dev",
    "build": "pnpm -r run build",
    "build:libs": "pnpm --filter \"./packages/*\" run build",
    "lint": "eslint .",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "test": "pnpm -r run test",
    "format": "prettier --write \"**/*.{ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,css,md}\"",
    "changeset": "changeset",
    "release": "pnpm build:libs && changeset publish",
    "clean": "pnpm -r exec rm -rf node_modules dist .turbo"
  },
  "devDependencies": {
    "@changesets/cli": "^2",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.1"
  },
  "packageManager": "pnpm@9.15.9"
}
